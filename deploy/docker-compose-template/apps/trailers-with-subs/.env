#---------------------------------------
# Norske trailere (trailers-with-subs)
# https://github.com/Lystad93/trailers-with-subs
#---------------------------------------

# Public URL used in the play links that players open. Must be reachable from your devices.
BASE_URL=https://${TRAILERS_WITH_SUBS_HOSTNAME}

# TMDB API key (v3) or read access token (v4). If empty, each user must enter one on /configure.
TMDB_API_KEY=

TZ=${TZ}

#---------------------------------------
# Subtitle translation (recommended)
#---------------------------------------
# YouTube rate limits its own Norwegian translations ("HTTP Error 429" on subtitles) for servers.
# With a translator the addon fetches the original subtitles and translates them itself.
# Gemini: key from https://aistudio.google.com/apikey (the key in apps/aiometadata/.env works too).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Or a LibreTranslate server:
# LIBRETRANSLATE_URL=http://libretranslate:5000
# LIBRETRANSLATE_API_KEY=

#---------------------------------------
# YouTube access
#---------------------------------------
# YouTube often blocks datacenter IPs (Oracle included) with "Sign in to confirm you're not a bot".
# Option 1 (recommended on Oracle): send yt-dlp through the template's WARP container
# (add 'warp' to COMPOSE_PROFILES):
# YTDLP_ARGS=--proxy http://warp:1080
# Option 2: export cookies from a browser signed in to a throwaway Google account
# (Netscape format) to ${DOCKER_DATA_DIR}/trailers-with-subs/cookies.txt, then:
# YTDLP_COOKIES=/data/cookies.txt

# Update yt-dlp each time the container starts (YouTube changes often).
YTDLP_AUTO_UPDATE=1

#---------------------------------------
# Video processing
#---------------------------------------
# Disk space for finished trailers; least recently watched are removed first.
CACHE_MAX_GB=10
# Trailers prepared at the same time. Each burned-in 1080p job uses about one CPU core or more.
MAX_JOBS=2
# Highest resolution for burned-in subtitles (re-encoding 4K on ARM is slow).
BURN_MAX_HEIGHT=1080
BURN_PRESET=veryfast
BURN_CRF=20

#---------------------------------------
# Rate limits
#---------------------------------------
# TMDB allows about 50 requests/second per IP, shared with AIOMetadata on the same server.
TMDB_RPS=20
TMDB_CONCURRENCY=6
# YouTube searches for Norwegian dubs allowed to wait in line; the rest are skipped and tried later.
SEARCH_QUEUE_MAX=5

LOG_LEVEL=info
